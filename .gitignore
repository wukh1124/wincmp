# --- Windows System Files ---
[Dd]esktop.ini
Thumbs.db
.DS_Store

# --- Go Specific ---
/WinCMP.exe
/WinCMP-debug.exe
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.syso
vendor/

# --- Project Specific Binaries ---
# 忽略所有 bin 目錄下的內容，但保留目錄結構用的 .gitkeep
/bin/*/*
!/bin/.gitkeep
/bin/php/*
!/bin/php/.gitkeep
/bin/mariadb/*
!/bin/mariadb/.gitkeep
/bin/caddy/*
!/bin/caddy/.gitkeep
/bin/heidisql/*
!/bin/heidisql/.gitkeep
/bin/composer/*
!/bin/composer/.gitkeep
/bin/node/*
!/bin/node/.gitkeep
/bin/bun/*
!/bin/bun/.gitkeep
/bin/mailpit/*
!/bin/mailpit/.gitkeep

# --- Data & Logs (忽略內容，保留目錄) ---
# 使用 !.gitkeep 確保空目錄結構能被追蹤，但忽略實際產生的資料
/data/mariadb/*
!/data/mariadb/.gitkeep

/data/mailpit/*
!/data/mailpit/.gitkeep

/logs/*
!/logs/.gitkeep

/www/*
!/www/.gitkeep

# --- Configuration & Sensitive Data ---
# 動態生成的憑證或密鑰與暫存檔
*.bak
*.key
*.pem
*.cer
*.crt
*.csr
*.7z
*.zip

*.caddy
!/conf/Caddyfile
!/conf/snippets/**/*.caddy

/conf/certs/
/conf/ssl/*
!/conf/ssl/.gitkeep
/conf/sites/*
!/conf/sites/.gitkeep

.sisyphus/
.memory-bank/

build/bin/
build/dev/
build/windows/installer/

# 項目落地頁
/website/screenshot/
/website/release.json
/website/.od-skills/
/website/index.html.artifact.json

/screenshot/backup