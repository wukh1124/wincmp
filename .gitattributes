# Declare the default behavior to handle all files as text and detect line endings automatically
* text=auto

# Explicitly set eol to lf for text files to avoid Wails generator creating CRLF mismatches
# go.mod / go.sum 由 Go 工具鏈以 LF 覆寫，若被 checkout 成 CRLF，每次 `go mod tidy` 都會重寫整份檔案
go.mod text eol=lf
go.sum text eol=lf
*.go text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.ico binary
*.svg text eol=lf
